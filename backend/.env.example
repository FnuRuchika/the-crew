# Copy to backend/.env and fill in. NEVER commit backend/.env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Voice (Phase 3). Get a key at https://elevenlabs.io/app/settings/api-keys
# A key restricted to Text to Speech is enough.
ELEVENLABS_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=20
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ELEVENLABS_MODEL=eleven_v4
# ELEVENLABS_FALLBACK_MODELS=eleven_multilingual_v2
# VOICE_CACHE_DIR=backend/.voice-cache
